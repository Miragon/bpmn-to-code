<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Miragon.BpmnToCode.Runtime</RootNamespace>
    <PackageId>Miragon.BpmnToCode.Runtime</PackageId>
    <Description>Shared runtime types and the compile-checked ProcessPath for C# APIs generated by bpmn-to-code</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Enum members and self-explanatory properties carry no doc comment of their own -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
