<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>BpmnToCode.Tool</AssemblyName>
    <RootNamespace>BpmnToCode.Tool</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bpmn-to-code</ToolCommandName>

    <PackageId>Miragon.BpmnToCode</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Miragon</Authors>
    <Description>Generates type-safe APIs from BPMN process models and validates the models. Needs Java 21 or newer.</Description>
    <PackageTags>bpmn;camunda;zeebe;operaton;codegen</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://miragon.github.io/bpmn-to-code/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Miragon/bpmn-to-code</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="cli/lib/**" Link="cli/lib/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="_RequireStagedJars" BeforeTargets="Build">
    <Error Condition="!Exists('cli/lib')" Text="No command-line tool staged: run stage-archives.sh first." />
  </Target>

</Project>
