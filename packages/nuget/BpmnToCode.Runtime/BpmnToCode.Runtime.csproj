<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>Miragon.BpmnToCode.Runtime</AssemblyName>
    <RootNamespace>Miragon.BpmnToCode.Runtime</RootNamespace>

    <PackageId>Miragon.BpmnToCode.Runtime</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Miragon</Authors>
    <Description>The types the C# Process APIs generated by bpmn-to-code are built from, and the compile-checked ProcessPath.</Description>
    <PackageTags>bpmn;camunda;zeebe;operaton;codegen</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://miragon.github.io/bpmn-to-code/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Miragon/bpmn-to-code</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
