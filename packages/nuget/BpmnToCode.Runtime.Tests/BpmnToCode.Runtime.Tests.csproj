<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>BpmnToCode.Runtime.Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</RepositoryRoot>
    <BpmnToCodeCli Condition="'$(BPMN_TO_CODE_CLI)' != ''">$(BPMN_TO_CODE_CLI)</BpmnToCodeCli>
    <BpmnToCodeCli Condition="'$(BpmnToCodeCli)' == '' and '$(OS)' == 'Windows_NT'">$(RepositoryRoot)bpmn-to-code-cli/build/install/bpmn-to-code/bin/bpmn-to-code.bat</BpmnToCodeCli>
    <BpmnToCodeCli Condition="'$(BpmnToCodeCli)' == ''">$(RepositoryRoot)bpmn-to-code-cli/build/install/bpmn-to-code/bin/bpmn-to-code</BpmnToCodeCli>
    <GeneratedApiDirectory>$(BaseIntermediateOutputPath)generated/</GeneratedApiDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BpmnToCode.Runtime/BpmnToCode.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$(RepositoryRoot)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BpmnToCodeCli</_Parameter1>
      <_Parameter2>$(BpmnToCodeCli)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <MiraVeloModel Include="$(RepositoryRoot)shared/bpmn/zeebe/bike-leasing.bpmn" />
    <MiraVeloModel Include="$(RepositoryRoot)bpmn-to-code-core/src/test/resources/bpmn/nested-subprocess.bpmn" />
    <ApprovalModel Include="Fixtures/approval.bpmn" />
    <None Include="Fixtures/*.bpmn" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The scenario tests compile against these APIs, generated by the CLI as a user's build would -->
  <Target Name="GenerateProcessApis" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(BpmnToCodeCli)')" Text="No CLI at $(BpmnToCodeCli). Run ./gradlew :bpmn-to-code-cli:installDist or set BPMN_TO_CODE_CLI." />
    <RemoveDir Directories="$(GeneratedApiDirectory)" />
    <Copy SourceFiles="@(MiraVeloModel)" DestinationFolder="$(GeneratedApiDirectory)models/miravelo" />
    <Copy SourceFiles="@(ApprovalModel)" DestinationFolder="$(GeneratedApiDirectory)models/approval" />
    <Exec Command="&quot;$(BpmnToCodeCli)&quot; generate-api --baseDir &quot;$(GeneratedApiDirectory)models/miravelo&quot; --filePattern *.bpmn --processEngine ZEEBE --outputLanguage CSHARP --outputFolderPath &quot;$(GeneratedApiDirectory)src&quot; --packagePath MiraVelo.Process" />
    <Exec Command="&quot;$(BpmnToCodeCli)&quot; generate-api --baseDir &quot;$(GeneratedApiDirectory)models/approval&quot; --filePattern *.bpmn --processEngine ZEEBE --outputLanguage CSHARP --outputFolderPath &quot;$(GeneratedApiDirectory)src&quot; --packagePath MiraVelo.Approval" />
    <ItemGroup>
      <Compile Include="$(GeneratedApiDirectory)src/**/*.cs" />
    </ItemGroup>
  </Target>

</Project>
