{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "outDir": "out"
  },
  "include": ["*.ts", "generated/**/*.ts"]
}
