{
  "name": "@miragon/bpmn-to-code-runtime",
  "version": "0.0.0-development",
  "description": "Shared runtime types and the compile-checked ProcessPath for TypeScript APIs generated by bpmn-to-code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/bpmn-to-code.git",
    "directory": "packages/npm/bpmn-to-code-runtime"
  },
  "homepage": "https://miragon.github.io/bpmn-to-code/",
  "keywords": [
    "bpmn",
    "camunda",
    "zeebe",
    "operaton",
    "codegen",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"build/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
