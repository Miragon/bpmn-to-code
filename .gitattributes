#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf
bpmn-to-code-cli/src/launcher/bpmn-to-code text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Code templates are rendered into generated files verbatim
bpmn-to-code-core/src/main/resources/io/miragon/bpmn/codegen/templates/** text eol=lf

# Binary files should be left untouched
*.jar           binary

# Mark auto-generated documentation as generated
bpmn-to-code-web/docs/index.html linguist-generated=true
