{
    "$schema": "https://miragon.github.io/bpmn-to-code/schema/process-model/2.0.json",
    "formatVersion": "2.0",
    "process": {
        "id": "sendNewsletter",
        "flowNodes": [
            {
                "id": "startEvent_editionCreated",
                "type": "startEvent",
                "outgoing": [
                    "flow_editionToLoadSubscribers"
                ]
            },
            {
                "id": "endEvent_editionSent",
                "type": "endEvent",
                "incoming": [
                    "flow_notifyAuthorToEditionSent"
                ]
            },
            {
                "id": "endEvent_noSubscribers",
                "type": "endEvent",
                "incoming": [
                    "flow_noSubscribers"
                ]
            },
            {
                "id": "eventSubProcess_errorHandling",
                "type": "subProcess",
                "triggeredByEvent": true,
                "flowNodes": [
                    {
                        "id": "event_mailRejected",
                        "type": "startEvent",
                        "outgoing": [
                            "flow_mailRejectedToAnalyze"
                        ],
                        "isInterrupting": true,
                        "eventDefinitions": [
                            {
                                "type": "message",
                                "messageRef": "Message_MailRejected"
                            }
                        ]
                    },
                    {
                        "id": "serviceTask_analyzeError",
                        "type": "serviceTask",
                        "incoming": [
                            "flow_mailRejectedToAnalyze"
                        ],
                        "outgoing": [
                            "flow_analyzeToCanSendAgain"
                        ],
                        "implementation": {
                            "type": "jobWorker",
                            "jobType": "newsletter.analyzeSendError"
                        }
                    },
                    {
                        "id": "gateway_canSendAgain",
                        "type": "exclusiveGateway",
                        "incoming": [
                            "flow_analyzeToCanSendAgain"
                        ],
                        "outgoing": [
                            "flow_canSendAgain",
                            "flow_cannotSendAgain"
                        ],
                        "default": "flow_canSendAgain"
                    },
                    {
                        "id": "escalationEndEvent_nofitySupport",
                        "type": "endEvent",
                        "incoming": [
                            "flow_cannotSendAgain"
                        ],
                        "eventDefinitions": [
                            {
                                "type": "escalation",
                                "escalationRef": "escalation_notifySupport"
                            }
                        ]
                    },
                    {
                        "id": "serviceTask_sendMailAgain",
                        "type": "serviceTask",
                        "incoming": [
                            "flow_canSendAgain"
                        ],
                        "outgoing": [
                            "flow_sendAgainToEventGateway"
                        ],
                        "implementation": {
                            "type": "jobWorker",
                            "jobType": "newsletter.sendMailToSubscriber"
                        }
                    },
                    {
                        "id": "eventGateway_afterSendingAgain",
                        "type": "eventBasedGateway",
                        "incoming": [
                            "flow_sendAgainToEventGateway"
                        ],
                        "outgoing": [
                            "flow_eventGatewayToTimer",
                            "flow_eventGatewayToMailRejectedAgain"
                        ]
                    },
                    {
                        "id": "event_mailRejectedAgain",
                        "type": "intermediateCatchEvent",
                        "incoming": [
                            "flow_eventGatewayToMailRejectedAgain"
                        ],
                        "outgoing": [
                            "flow_mailRejectedAgainToEscalation"
                        ],
                        "eventDefinitions": [
                            {
                                "type": "message",
                                "messageRef": "Message_MailRejectedAgain"
                            }
                        ]
                    },
                    {
                        "id": "escalationEndEvent_nofitySupportAfterRepeatedError",
                        "type": "endEvent",
                        "incoming": [
                            "flow_mailRejectedAgainToEscalation"
                        ]
                    },
                    {
                        "id": "timer_noRejectionForOneDay",
                        "type": "intermediateCatchEvent",
                        "incoming": [
                            "flow_eventGatewayToTimer"
                        ],
                        "outgoing": [
                            "flow_timerToIssueResolved"
                        ],
                        "eventDefinitions": [
                            {
                                "type": "timer",
                                "timerType": "DURATION",
                                "expression": "PT1D"
                            }
                        ]
                    },
                    {
                        "id": "endEvent_issueResolved",
                        "type": "endEvent",
                        "incoming": [
                            "flow_timerToIssueResolved"
                        ]
                    }
                ],
                "sequenceFlows": [
                    {
                        "id": "flow_mailRejectedToAnalyze",
                        "sourceRef": "event_mailRejected",
                        "targetRef": "serviceTask_analyzeError"
                    },
                    {
                        "id": "flow_analyzeToCanSendAgain",
                        "sourceRef": "serviceTask_analyzeError",
                        "targetRef": "gateway_canSendAgain"
                    },
                    {
                        "id": "flow_canSendAgain",
                        "sourceRef": "gateway_canSendAgain",
                        "targetRef": "serviceTask_sendMailAgain",
                        "name": "Yes"
                    },
                    {
                        "id": "flow_cannotSendAgain",
                        "sourceRef": "gateway_canSendAgain",
                        "targetRef": "escalationEndEvent_nofitySupport",
                        "name": "No",
                        "conditionExpression": "${rejection.reason == \"PERMANENT\"}"
                    },
                    {
                        "id": "flow_sendAgainToEventGateway",
                        "sourceRef": "serviceTask_sendMailAgain",
                        "targetRef": "eventGateway_afterSendingAgain"
                    },
                    {
                        "id": "flow_eventGatewayToTimer",
                        "sourceRef": "eventGateway_afterSendingAgain",
                        "targetRef": "timer_noRejectionForOneDay"
                    },
                    {
                        "id": "flow_eventGatewayToMailRejectedAgain",
                        "sourceRef": "eventGateway_afterSendingAgain",
                        "targetRef": "event_mailRejectedAgain"
                    },
                    {
                        "id": "flow_mailRejectedAgainToEscalation",
                        "sourceRef": "event_mailRejectedAgain",
                        "targetRef": "escalationEndEvent_nofitySupportAfterRepeatedError"
                    },
                    {
                        "id": "flow_timerToIssueResolved",
                        "sourceRef": "timer_noRejectionForOneDay",
                        "targetRef": "endEvent_issueResolved"
                    }
                ]
            },
            {
                "id": "gateway_hasSubscribers",
                "type": "exclusiveGateway",
                "incoming": [
                    "flow_loadSubscribersToGateway"
                ],
                "outgoing": [
                    "flow_hasSubscribers",
                    "flow_noSubscribers"
                ],
                "default": "flow_hasSubscribers"
            },
            {
                "id": "serviceTask_loadSubscribers",
                "type": "serviceTask",
                "incoming": [
                    "flow_editionToLoadSubscribers"
                ],
                "outgoing": [
                    "flow_loadSubscribersToGateway"
                ],
                "implementation": {
                    "type": "jobWorker",
                    "jobType": "newsletter.loadSubscribers"
                },
                "variables": [
                    {
                        "name": "subscribers",
                        "direction": "OUTPUT"
                    },
                    {
                        "name": "author",
                        "direction": "OUTPUT"
                    }
                ]
            },
            {
                "id": "serviceTask_notifyAuthor",
                "type": "serviceTask",
                "incoming": [
                    "flow_sendToNotifyAuthor"
                ],
                "outgoing": [
                    "flow_notifyAuthorToEditionSent"
                ],
                "implementation": {
                    "type": "jobWorker",
                    "jobType": "newsletter.notifyAuthor"
                }
            },
            {
                "id": "serviceTask_sendToSubscriber",
                "type": "serviceTask",
                "incoming": [
                    "flow_hasSubscribers"
                ],
                "outgoing": [
                    "flow_sendToNotifyAuthor"
                ],
                "implementation": {
                    "type": "jobWorker",
                    "jobType": "newsletter.sendMailToSubscriber"
                }
            }
        ]
    },
    "definitions": {
        "messages": [
            {
                "id": "Message_MailRejected",
                "name": "Message_MailRejected"
            },
            {
                "id": "Message_MailRejectedAgain",
                "name": "Message_MailRejectedAgain"
            }
        ],
        "escalations": [
            {
                "id": "escalation_notifySupport",
                "name": "escalation_notifySupport",
                "escalationCode": "200"
            }
        ]
    },
    "variants": [
        {
            "name": "send",
            "flowNodes": [
                {
                    "id": "startEvent_editionCreated",
                    "type": "startEvent",
                    "outgoing": [
                        "flow_editionToLoadSubscribers"
                    ]
                },
                {
                    "id": "serviceTask_loadSubscribers",
                    "type": "serviceTask",
                    "incoming": [
                        "flow_editionToLoadSubscribers"
                    ],
                    "outgoing": [
                        "flow_loadSubscribersToGateway"
                    ],
                    "implementation": {
                        "type": "jobWorker",
                        "jobType": "newsletter.loadSubscribers"
                    },
                    "variables": [
                        {
                            "name": "subscribers",
                            "direction": "OUTPUT"
                        },
                        {
                            "name": "author",
                            "direction": "OUTPUT"
                        }
                    ]
                },
                {
                    "id": "gateway_hasSubscribers",
                    "type": "exclusiveGateway",
                    "incoming": [
                        "flow_loadSubscribersToGateway"
                    ],
                    "outgoing": [
                        "flow_hasSubscribers",
                        "flow_noSubscribers"
                    ],
                    "default": "flow_hasSubscribers"
                },
                {
                    "id": "endEvent_noSubscribers",
                    "type": "endEvent",
                    "incoming": [
                        "flow_noSubscribers"
                    ]
                },
                {
                    "id": "serviceTask_sendToSubscriber",
                    "type": "serviceTask",
                    "incoming": [
                        "flow_hasSubscribers"
                    ],
                    "outgoing": [
                        "flow_sendToNotifyAuthor"
                    ],
                    "implementation": {
                        "type": "jobWorker",
                        "jobType": "newsletter.sendMailToSubscriber"
                    }
                },
                {
                    "id": "serviceTask_notifyAuthor",
                    "type": "serviceTask",
                    "incoming": [
                        "flow_sendToNotifyAuthor"
                    ],
                    "outgoing": [
                        "flow_notifyAuthorToEditionSent"
                    ],
                    "implementation": {
                        "type": "jobWorker",
                        "jobType": "newsletter.notifyAuthor"
                    }
                },
                {
                    "id": "endEvent_editionSent",
                    "type": "endEvent",
                    "incoming": [
                        "flow_notifyAuthorToEditionSent"
                    ]
                },
                {
                    "id": "eventSubProcess_errorHandling",
                    "type": "subProcess",
                    "triggeredByEvent": true,
                    "flowNodes": [
                        {
                            "id": "event_mailRejected",
                            "type": "startEvent",
                            "outgoing": [
                                "flow_mailRejectedToAnalyze"
                            ],
                            "isInterrupting": true,
                            "eventDefinitions": [
                                {
                                    "type": "message",
                                    "messageRef": "Message_MailRejected"
                                }
                            ]
                        },
                        {
                            "id": "serviceTask_analyzeError",
                            "type": "serviceTask",
                            "incoming": [
                                "flow_mailRejectedToAnalyze"
                            ],
                            "outgoing": [
                                "flow_analyzeToCanSendAgain"
                            ],
                            "implementation": {
                                "type": "jobWorker",
                                "jobType": "newsletter.analyzeSendError"
                            }
                        },
                        {
                            "id": "gateway_canSendAgain",
                            "type": "exclusiveGateway",
                            "incoming": [
                                "flow_analyzeToCanSendAgain"
                            ],
                            "outgoing": [
                                "flow_canSendAgain",
                                "flow_cannotSendAgain"
                            ],
                            "default": "flow_canSendAgain"
                        },
                        {
                            "id": "escalationEndEvent_nofitySupport",
                            "type": "endEvent",
                            "incoming": [
                                "flow_cannotSendAgain"
                            ],
                            "eventDefinitions": [
                                {
                                    "type": "escalation",
                                    "escalationRef": "escalation_notifySupport"
                                }
                            ]
                        },
                        {
                            "id": "serviceTask_sendMailAgain",
                            "type": "serviceTask",
                            "incoming": [
                                "flow_canSendAgain"
                            ],
                            "outgoing": [
                                "flow_sendAgainToEventGateway"
                            ],
                            "implementation": {
                                "type": "jobWorker",
                                "jobType": "newsletter.sendMailToSubscriber"
                            }
                        },
                        {
                            "id": "eventGateway_afterSendingAgain",
                            "type": "eventBasedGateway",
                            "incoming": [
                                "flow_sendAgainToEventGateway"
                            ],
                            "outgoing": [
                                "flow_eventGatewayToTimer",
                                "flow_eventGatewayToMailRejectedAgain"
                            ]
                        },
                        {
                            "id": "event_mailRejectedAgain",
                            "type": "intermediateCatchEvent",
                            "incoming": [
                                "flow_eventGatewayToMailRejectedAgain"
                            ],
                            "outgoing": [
                                "flow_mailRejectedAgainToEscalation"
                            ],
                            "eventDefinitions": [
                                {
                                    "type": "message",
                                    "messageRef": "Message_MailRejectedAgain"
                                }
                            ]
                        },
                        {
                            "id": "escalationEndEvent_nofitySupportAfterRepeatedError",
                            "type": "endEvent",
                            "incoming": [
                                "flow_mailRejectedAgainToEscalation"
                            ]
                        },
                        {
                            "id": "timer_noRejectionForOneDay",
                            "type": "intermediateCatchEvent",
                            "incoming": [
                                "flow_eventGatewayToTimer"
                            ],
                            "outgoing": [
                                "flow_timerToIssueResolved"
                            ],
                            "eventDefinitions": [
                                {
                                    "type": "timer",
                                    "timerType": "DURATION",
                                    "expression": "PT1D"
                                }
                            ]
                        },
                        {
                            "id": "endEvent_issueResolved",
                            "type": "endEvent",
                            "incoming": [
                                "flow_timerToIssueResolved"
                            ]
                        }
                    ],
                    "sequenceFlows": [
                        {
                            "id": "flow_mailRejectedToAnalyze",
                            "sourceRef": "event_mailRejected",
                            "targetRef": "serviceTask_analyzeError"
                        },
                        {
                            "id": "flow_analyzeToCanSendAgain",
                            "sourceRef": "serviceTask_analyzeError",
                            "targetRef": "gateway_canSendAgain"
                        },
                        {
                            "id": "flow_canSendAgain",
                            "sourceRef": "gateway_canSendAgain",
                            "targetRef": "serviceTask_sendMailAgain",
                            "name": "Yes"
                        },
                        {
                            "id": "flow_cannotSendAgain",
                            "sourceRef": "gateway_canSendAgain",
                            "targetRef": "escalationEndEvent_nofitySupport",
                            "name": "No",
                            "conditionExpression": "${rejection.reason == \"PERMANENT\"}"
                        },
                        {
                            "id": "flow_sendAgainToEventGateway",
                            "sourceRef": "serviceTask_sendMailAgain",
                            "targetRef": "eventGateway_afterSendingAgain"
                        },
                        {
                            "id": "flow_eventGatewayToTimer",
                            "sourceRef": "eventGateway_afterSendingAgain",
                            "targetRef": "timer_noRejectionForOneDay"
                        },
                        {
                            "id": "flow_eventGatewayToMailRejectedAgain",
                            "sourceRef": "eventGateway_afterSendingAgain",
                            "targetRef": "event_mailRejectedAgain"
                        },
                        {
                            "id": "flow_mailRejectedAgainToEscalation",
                            "sourceRef": "event_mailRejectedAgain",
                            "targetRef": "escalationEndEvent_nofitySupportAfterRepeatedError"
                        },
                        {
                            "id": "flow_timerToIssueResolved",
                            "sourceRef": "timer_noRejectionForOneDay",
                            "targetRef": "endEvent_issueResolved"
                        }
                    ]
                }
            ],
            "sequenceFlows": [
                {
                    "id": "flow_editionToLoadSubscribers",
                    "sourceRef": "startEvent_editionCreated",
                    "targetRef": "serviceTask_loadSubscribers"
                },
                {
                    "id": "flow_loadSubscribersToGateway",
                    "sourceRef": "serviceTask_loadSubscribers",
                    "targetRef": "gateway_hasSubscribers"
                },
                {
                    "id": "flow_hasSubscribers",
                    "sourceRef": "gateway_hasSubscribers",
                    "targetRef": "serviceTask_sendToSubscriber",
                    "name": "Yes"
                },
                {
                    "id": "flow_noSubscribers",
                    "sourceRef": "gateway_hasSubscribers",
                    "targetRef": "endEvent_noSubscribers",
                    "name": "No",
                    "conditionExpression": "${subscribers.size() > 0}"
                },
                {
                    "id": "flow_sendToNotifyAuthor",
                    "sourceRef": "serviceTask_sendToSubscriber",
                    "targetRef": "serviceTask_notifyAuthor"
                },
                {
                    "id": "flow_notifyAuthorToEditionSent",
                    "sourceRef": "serviceTask_notifyAuthor",
                    "targetRef": "endEvent_editionSent"
                }
            ]
        }
    ]
}