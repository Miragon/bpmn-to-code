{
    "$schema": "https://miragon.github.io/bpmn-to-code/schema/process-model/2.0.json",
    "formatVersion": "2.0",
    "process": {
        "id": "newsletterSubscription",
        "flowNodes": [
            {
                "id": "startEvent_submitRegistrationForm",
                "type": "startEvent",
                "name": "Submit newsletter form",
                "outgoing": [
                    "flow_submitToIncrementCounter"
                ],
                "eventDefinitions": [
                    {
                        "type": "message",
                        "messageRef": "Message_FormSubmitted"
                    }
                ]
            },
            {
                "id": "serviceTask_incrementSubscriptionCounter",
                "type": "serviceTask",
                "name": "Increment subscription counter",
                "incoming": [
                    "flow_submitToIncrementCounter"
                ],
                "outgoing": [
                    "flow_incrementCounterToConfirmation"
                ],
                "boundaryEventRefs": [
                    "compensationEvent_onSubscriptionCounter"
                ],
                "implementation": {
                    "type": "jobWorker",
                    "jobType": "counterClass"
                }
            },
            {
                "id": "compensationEvent_onSubscriptionCounter",
                "type": "boundaryEvent",
                "name": "Registration aborted",
                "attachedToRef": "serviceTask_incrementSubscriptionCounter",
                "cancelActivity": true,
                "eventDefinitions": [
                    {
                        "type": "compensation"
                    }
                ]
            },
            {
                "id": "subProcess_confirmation",
                "type": "subProcess",
                "name": "Subscription Confirmation",
                "incoming": [
                    "flow_incrementCounterToConfirmation"
                ],
                "outgoing": [
                    "flow_confirmationToSplit"
                ],
                "boundaryEventRefs": [
                    "errorEvent_invalidMail",
                    "timer_after3Days"
                ],
                "flowNodes": [
                    {
                        "id": "startEvent_requestReceived",
                        "type": "startEvent",
                        "name": "Subscription requested",
                        "outgoing": [
                            "flow_requestToConfirmationMail"
                        ]
                    },
                    {
                        "id": "serviceTask_sendConfirmationMail",
                        "type": "serviceTask",
                        "name": "Send confirmation mail",
                        "incoming": [
                            "flow_requestToConfirmationMail",
                            "flow_everyDayToConfirmationMail"
                        ],
                        "outgoing": [
                            "flow_confirmationMailToConfirm"
                        ],
                        "implementation": {
                            "type": "jobWorker",
                            "jobType": "newsletter.sendConfirmationMail"
                        }
                    },
                    {
                        "id": "userTask_confirmRegistration",
                        "type": "userTask",
                        "name": "Confirm subscription",
                        "incoming": [
                            "flow_confirmationMailToConfirm"
                        ],
                        "outgoing": [
                            "flow_confirmToConfirmed"
                        ],
                        "boundaryEventRefs": [
                            "timer_everyDay"
                        ]
                    },
                    {
                        "id": "timer_everyDay",
                        "type": "boundaryEvent",
                        "name": "Every day",
                        "outgoing": [
                            "flow_everyDayToConfirmationMail"
                        ],
                        "attachedToRef": "userTask_confirmRegistration",
                        "cancelActivity": false,
                        "eventDefinitions": [
                            {
                                "type": "timer",
                                "timerType": "DURATION",
                                "expression": "PT1M"
                            }
                        ]
                    },
                    {
                        "id": "endEvent_subscriptionConfirmed",
                        "type": "endEvent",
                        "name": "Subscription confirmed",
                        "incoming": [
                            "flow_confirmToConfirmed"
                        ]
                    }
                ],
                "sequenceFlows": [
                    {
                        "id": "flow_requestToConfirmationMail",
                        "sourceRef": "startEvent_requestReceived",
                        "targetRef": "serviceTask_sendConfirmationMail"
                    },
                    {
                        "id": "flow_everyDayToConfirmationMail",
                        "sourceRef": "timer_everyDay",
                        "targetRef": "serviceTask_sendConfirmationMail"
                    },
                    {
                        "id": "flow_confirmationMailToConfirm",
                        "sourceRef": "serviceTask_sendConfirmationMail",
                        "targetRef": "userTask_confirmRegistration"
                    },
                    {
                        "id": "flow_confirmToConfirmed",
                        "sourceRef": "userTask_confirmRegistration",
                        "targetRef": "endEvent_subscriptionConfirmed"
                    }
                ]
            },
            {
                "id": "errorEvent_invalidMail",
                "type": "boundaryEvent",
                "name": "Invalid Mail",
                "outgoing": [
                    "flow_invalidMailToNotPossible"
                ],
                "attachedToRef": "subProcess_confirmation",
                "cancelActivity": true,
                "eventDefinitions": [
                    {
                        "type": "error",
                        "errorRef": "Error_InvalidMail"
                    }
                ]
            },
            {
                "id": "endEvent_registrationNotPossible",
                "type": "endEvent",
                "name": "Registration not possible",
                "incoming": [
                    "flow_invalidMailToNotPossible"
                ],
                "eventDefinitions": [
                    {
                        "type": "signal",
                        "signalRef": "Signal_RegistrationNotPossible"
                    }
                ]
            },
            {
                "id": "timer_after3Days",
                "type": "boundaryEvent",
                "name": "After 3 days",
                "outgoing": [
                    "flow_after3DaysToAbort"
                ],
                "attachedToRef": "subProcess_confirmation",
                "cancelActivity": true,
                "eventDefinitions": [
                    {
                        "type": "timer",
                        "timerType": "DURATION",
                        "expression": "${testVariable}"
                    }
                ]
            },
            {
                "id": "callActivity_abortRegistration",
                "type": "callActivity",
                "name": "Abort registration",
                "incoming": [
                    "flow_after3DaysToAbort"
                ],
                "outgoing": [
                    "flow_abortToRegistrationAborted"
                ],
                "calledElement": {
                    "processId": "abort-registration"
                }
            },
            {
                "id": "compensationEndEvent_registrationAborted",
                "type": "endEvent",
                "name": "Registration aborted",
                "incoming": [
                    "flow_abortToRegistrationAborted"
                ],
                "eventDefinitions": [
                    {
                        "type": "compensation"
                    }
                ]
            },
            {
                "id": "gateway_splitNotifications",
                "type": "parallelGateway",
                "incoming": [
                    "flow_confirmationToSplit"
                ],
                "outgoing": [
                    "flow_splitToWelcomeMail",
                    "flow_splitToNotifyCommunity"
                ]
            },
            {
                "id": "serviceTask_notifyCommunity",
                "type": "serviceTask",
                "name": "Notify community",
                "incoming": [
                    "flow_splitToNotifyCommunity"
                ],
                "outgoing": [
                    "flow_notifyCommunityToJoin"
                ],
                "implementation": {
                    "type": "jobWorker",
                    "jobType": "newsletter.notifyCommunity"
                },
                "engineAttributes": {
                    "camunda:asyncBefore": true,
                    "camunda:asyncAfter": true,
                    "camunda:exclusive": false
                }
            },
            {
                "id": "gateway_joinNotifications",
                "type": "parallelGateway",
                "incoming": [
                    "flow_welcomeMailToJoin",
                    "flow_notifyCommunityToJoin"
                ],
                "outgoing": [
                    "flow_joinToRegistrationCompleted"
                ]
            },
            {
                "id": "endEvent_registrationCompleted",
                "type": "endEvent",
                "name": "Registration completed",
                "incoming": [
                    "flow_joinToRegistrationCompleted"
                ],
                "implementation": {
                    "type": "jobWorker",
                    "jobType": "newsletter.registrationCompleted"
                }
            },
            {
                "id": "serviceTask_sendWelcomeMail",
                "type": "serviceTask",
                "name": "Send Welcome-Mail",
                "incoming": [
                    "flow_splitToWelcomeMail"
                ],
                "outgoing": [
                    "flow_welcomeMailToJoin"
                ],
                "implementation": {
                    "type": "jobWorker",
                    "jobType": "newsletter.sendWelcomeMail"
                },
                "engineAttributes": {
                    "camunda:asyncBefore": true,
                    "camunda:asyncAfter": true,
                    "camunda:exclusive": false
                }
            },
            {
                "id": "serviceTask_decrementSubscriptionCounter",
                "type": "task",
                "name": "Decrement subscription counter"
            }
        ],
        "sequenceFlows": [
            {
                "id": "flow_confirmationToSplit",
                "sourceRef": "subProcess_confirmation",
                "targetRef": "gateway_splitNotifications"
            },
            {
                "id": "flow_invalidMailToNotPossible",
                "sourceRef": "errorEvent_invalidMail",
                "targetRef": "endEvent_registrationNotPossible"
            },
            {
                "id": "flow_incrementCounterToConfirmation",
                "sourceRef": "serviceTask_incrementSubscriptionCounter",
                "targetRef": "subProcess_confirmation"
            },
            {
                "id": "flow_splitToWelcomeMail",
                "sourceRef": "gateway_splitNotifications",
                "targetRef": "serviceTask_sendWelcomeMail"
            },
            {
                "id": "flow_joinToRegistrationCompleted",
                "sourceRef": "gateway_joinNotifications",
                "targetRef": "endEvent_registrationCompleted"
            },
            {
                "id": "flow_abortToRegistrationAborted",
                "sourceRef": "callActivity_abortRegistration",
                "targetRef": "compensationEndEvent_registrationAborted"
            },
            {
                "id": "flow_submitToIncrementCounter",
                "sourceRef": "startEvent_submitRegistrationForm",
                "targetRef": "serviceTask_incrementSubscriptionCounter"
            },
            {
                "id": "flow_notifyCommunityToJoin",
                "sourceRef": "serviceTask_notifyCommunity",
                "targetRef": "gateway_joinNotifications"
            },
            {
                "id": "flow_welcomeMailToJoin",
                "sourceRef": "serviceTask_sendWelcomeMail",
                "targetRef": "gateway_joinNotifications"
            },
            {
                "id": "flow_after3DaysToAbort",
                "sourceRef": "timer_after3Days",
                "targetRef": "callActivity_abortRegistration"
            },
            {
                "id": "flow_splitToNotifyCommunity",
                "sourceRef": "gateway_splitNotifications",
                "targetRef": "serviceTask_notifyCommunity"
            }
        ]
    },
    "definitions": {
        "messages": [
            {
                "id": "Message_FormSubmitted",
                "name": "Message_FormSubmitted"
            }
        ],
        "signals": [
            {
                "id": "Signal_RegistrationNotPossible",
                "name": "Signal_RegistrationNotPossible"
            }
        ],
        "errors": [
            {
                "id": "Error_InvalidMail",
                "name": "Error_InvalidMail",
                "errorCode": "500"
            }
        ]
    }
}
