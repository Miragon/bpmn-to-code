<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_c7_catchAllError"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="catchAllErrorProcess" isExecutable="true">
    <bpmn:startEvent id="startEvent_bikeReturned" name="Bike returned">
      <bpmn:outgoing>flow_bikeReturnedToInspectBike</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_bikeReturnedToInspectBike" sourceRef="startEvent_bikeReturned" targetRef="task_inspectBike" />
    <bpmn:task id="task_inspectBike" name="Inspect bike">
      <bpmn:incoming>flow_bikeReturnedToInspectBike</bpmn:incoming>
      <bpmn:outgoing>flow_inspectBikeToBikeInspected</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_inspectBikeToBikeInspected" sourceRef="task_inspectBike" targetRef="endEvent_bikeInspected" />
    <bpmn:endEvent id="endEvent_bikeInspected" name="Bike inspected">
      <bpmn:incoming>flow_inspectBikeToBikeInspected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="boundary_anyError" name="Any error" attachedToRef="task_inspectBike">
      <bpmn:outgoing>flow_anyErrorToInspectionFailed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="errorEventDefinition_anyError" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_anyErrorToInspectionFailed" sourceRef="boundary_anyError" targetRef="endEvent_inspectionFailed" />
    <bpmn:endEvent id="endEvent_inspectionFailed" name="Inspection failed">
      <bpmn:incoming>flow_anyErrorToInspectionFailed</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="catchAllErrorProcess">
      <bpmndi:BPMNShape id="startEvent_bikeReturned_di" bpmnElement="startEvent_bikeReturned">
        <dc:Bounds x="172" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inspectBike_di" bpmnElement="task_inspectBike">
        <dc:Bounds x="260" y="78" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_bikeInspected_di" bpmnElement="endEvent_bikeInspected">
        <dc:Bounds x="412" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_inspectionFailed_di" bpmnElement="endEvent_inspectionFailed">
        <dc:Bounds x="412" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundary_anyError_di" bpmnElement="boundary_anyError">
        <dc:Bounds x="292" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_bikeReturnedToInspectBike_di" bpmnElement="flow_bikeReturnedToInspectBike">
        <di:waypoint x="208" y="118" />
        <di:waypoint x="260" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inspectBikeToBikeInspected_di" bpmnElement="flow_inspectBikeToBikeInspected">
        <di:waypoint x="360" y="118" />
        <di:waypoint x="412" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_anyErrorToInspectionFailed_di" bpmnElement="flow_anyErrorToInspectionFailed">
        <di:waypoint x="310" y="176" />
        <di:waypoint x="310" y="240" />
        <di:waypoint x="412" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
