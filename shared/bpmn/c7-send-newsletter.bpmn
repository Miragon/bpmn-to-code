<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_180pfvm" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="sendNewsletter" isExecutable="true">
    <bpmn:startEvent id="startEvent_editionCreated" name="Newsletter edition created">
      <bpmn:outgoing>flow_editionToLoadSubscribers</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_editionToLoadSubscribers" sourceRef="startEvent_editionCreated" targetRef="serviceTask_loadSubscribers" />
    <bpmn:serviceTask id="serviceTask_loadSubscribers" name="Load subscribers" camunda:type="external" camunda:topic="newsletter.loadSubscribers">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="subscribers">${subscribers}</camunda:outputParameter>
          <camunda:outputParameter name="author">${author}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_editionToLoadSubscribers</bpmn:incoming>
      <bpmn:outgoing>flow_loadSubscribersToGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_loadSubscribersToGateway" sourceRef="serviceTask_loadSubscribers" targetRef="gateway_hasSubscribers" />
    <bpmn:serviceTask id="serviceTask_sendToSubscriber" name="Send to subscriber" camunda:type="external" camunda:topic="newsletter.sendMailToSubscriber">
      <bpmn:incoming>flow_hasSubscribers</bpmn:incoming>
      <bpmn:outgoing>flow_sendToNotifyAuthor</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${subscribers}" camunda:elementVariable="subscriber" />
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_editionSent" name="Newsletter edition send">
      <bpmn:incoming>flow_notifyAuthorToEditionSent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_sendToNotifyAuthor" sourceRef="serviceTask_sendToSubscriber" targetRef="serviceTask_notifyAuthor" />
    <bpmn:sequenceFlow id="flow_notifyAuthorToEditionSent" sourceRef="serviceTask_notifyAuthor" targetRef="endEvent_editionSent" />
    <bpmn:serviceTask id="serviceTask_notifyAuthor" name="Notify authors" camunda:type="external" camunda:topic="newsletter.notifyAuthor">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="test">null</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_sendToNotifyAuthor</bpmn:incoming>
      <bpmn:outgoing>flow_notifyAuthorToEditionSent</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="${authors}" camunda:elementVariable="author" />
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_hasSubscribers" name="Has subscribers?" default="flow_hasSubscribers">
      <bpmn:incoming>flow_loadSubscribersToGateway</bpmn:incoming>
      <bpmn:outgoing>flow_hasSubscribers</bpmn:outgoing>
      <bpmn:outgoing>flow_noSubscribers</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_hasSubscribers" name="Yes" sourceRef="gateway_hasSubscribers" targetRef="serviceTask_sendToSubscriber">
      <bpmn:extensionElements />
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="endEvent_noSubscribers" name="No subscribers found">
      <bpmn:incoming>flow_noSubscribers</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_noSubscribers" name="No" sourceRef="gateway_hasSubscribers" targetRef="endEvent_noSubscribers">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${subscribers.size() &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:subProcess id="eventSubProcess_errorHandling" name="Error handling" triggeredByEvent="true">
      <bpmn:startEvent id="event_mailRejected" name="Mail rejected">
        <bpmn:outgoing>flow_mailRejectedToAnalyze</bpmn:outgoing>
        <bpmn:messageEventDefinition id="messageEventDefinition_mailRejected" messageRef="message_mailRejected" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="flow_mailRejectedToAnalyze" sourceRef="event_mailRejected" targetRef="serviceTask_analyzeError" />
      <bpmn:serviceTask id="serviceTask_analyzeError" name="Analyze error" camunda:type="external" camunda:topic="newsletter.analyzeSendError">
        <bpmn:incoming>flow_mailRejectedToAnalyze</bpmn:incoming>
        <bpmn:outgoing>flow_analyzeToCanSendAgain</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="gateway_canSendAgain" name="Can re-send?" default="flow_canSendAgain">
        <bpmn:incoming>flow_analyzeToCanSendAgain</bpmn:incoming>
        <bpmn:outgoing>flow_canSendAgain</bpmn:outgoing>
        <bpmn:outgoing>flow_cannotSendAgain</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="flow_analyzeToCanSendAgain" sourceRef="serviceTask_analyzeError" targetRef="gateway_canSendAgain" />
      <bpmn:sequenceFlow id="flow_canSendAgain" name="Yes" sourceRef="gateway_canSendAgain" targetRef="serviceTask_sendMailAgain" />
      <bpmn:sequenceFlow id="flow_sendAgainToEventGateway" sourceRef="serviceTask_sendMailAgain" targetRef="eventGateway_afterSendingAgain" />
      <bpmn:eventBasedGateway id="eventGateway_afterSendingAgain">
        <bpmn:incoming>flow_sendAgainToEventGateway</bpmn:incoming>
        <bpmn:outgoing>flow_eventGatewayToTimer</bpmn:outgoing>
        <bpmn:outgoing>flow_eventGatewayToMailRejectedAgain</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:sequenceFlow id="flow_cannotSendAgain" name="No" sourceRef="gateway_canSendAgain" targetRef="escalationEndEvent_nofitySupport">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${canBeResolved == false}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:serviceTask id="serviceTask_sendMailAgain" name="Send mail again" camunda:type="external" camunda:topic="newsletter.sendMailToSubscriber">
        <bpmn:incoming>flow_canSendAgain</bpmn:incoming>
        <bpmn:outgoing>flow_sendAgainToEventGateway</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="flow_eventGatewayToTimer" sourceRef="eventGateway_afterSendingAgain" targetRef="timer_noRejectionForOneDay" />
      <bpmn:intermediateCatchEvent id="timer_noRejectionForOneDay" name="No rejection for 1 day">
        <bpmn:incoming>flow_eventGatewayToTimer</bpmn:incoming>
        <bpmn:outgoing>flow_timerToIssueResolved</bpmn:outgoing>
        <bpmn:timerEventDefinition id="timerEventDefinition_noRejectionForOneDay">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="escalationEndEvent_nofitySupport" name="Notify support">
        <bpmn:incoming>flow_cannotSendAgain</bpmn:incoming>
        <bpmn:escalationEventDefinition id="escalationEventDefinition_notifySupport" escalationRef="escalation_notifySupport" />
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="event_mailRejectedAgain" name="Mail rejected again">
        <bpmn:incoming>flow_eventGatewayToMailRejectedAgain</bpmn:incoming>
        <bpmn:outgoing>flow_mailRejectedAgainToEscalation</bpmn:outgoing>
        <bpmn:messageEventDefinition id="messageEventDefinition_mailRejectedAgain" messageRef="message_mailRejectedAgain" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="flow_eventGatewayToMailRejectedAgain" sourceRef="eventGateway_afterSendingAgain" targetRef="event_mailRejectedAgain" />
      <bpmn:sequenceFlow id="flow_mailRejectedAgainToEscalation" sourceRef="event_mailRejectedAgain" targetRef="escalationEndEvent_nofitySupportAfterRepeatedError" />
      <bpmn:endEvent id="escalationEndEvent_nofitySupportAfterRepeatedError" name="Notify support">
        <bpmn:incoming>flow_mailRejectedAgainToEscalation</bpmn:incoming>
        <bpmn:escalationEventDefinition id="escalationEventDefinition_notifySupportAfterRepeatedError" escalationRef="escalation_notifySupport" />
      </bpmn:endEvent>
      <bpmn:endEvent id="endEvent_issueResolved" name="Temporary issue resolved">
        <bpmn:incoming>flow_timerToIssueResolved</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_timerToIssueResolved" sourceRef="timer_noRejectionForOneDay" targetRef="endEvent_issueResolved" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:escalation id="escalation_notifySupport" name="escalation_notifySupport" escalationCode="200" />
  <bpmn:message id="message_mailRejectedAgain" name="Message_MailRejectedAgain" />
  <bpmn:message id="message_mailRejected" name="Message_MailRejected" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="sendNewsletter">
