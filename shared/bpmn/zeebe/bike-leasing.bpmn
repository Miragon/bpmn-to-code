<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="definitions_bikeLeasing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  <bpmn:message id="message_leasingRequestReceived" name="miravelo.leasingRequestReceived" />
  <bpmn:message id="message_contractSigned" name="miravelo.contractSigned">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="message_handoverReported" name="miravelo.handoverReported">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="message_applicationWithdrawn" name="miravelo.applicationWithdrawn">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="message_addressChanged" name="miravelo.addressChanged">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="error_applicationInvalid" name="miravelo.applicationInvalid" errorCode="applicationInvalid" />
  <bpmn:escalation id="escalation_contractNotSigned" name="miravelo.contractNotSigned" escalationCode="contractNotSigned" />
  <bpmn:process id="bikeLeasing" name="MiraVelo Bike Leasing" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:properties>
        <zeebe:property name="variantName" value="corporate" />
      </zeebe:properties>
    </bpmn:extensionElements>
    <bpmn:startEvent id="startEvent_leasingRequestReceived" name="Leasing request received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=applicationId" target="applicationId" />
          <zeebe:output source="=bikeIds" target="bikeIds" />
          <zeebe:output source="=monthlyNetIncome" target="monthlyNetIncome" />
          <zeebe:output source="=age" target="age" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_leasingRequestReceivedToValidateApplication</bpmn:outgoing>
      <bpmn:messageEventDefinition id="messageEventDefinition_leasingRequestReceived" messageRef="message_leasingRequestReceived" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_validateApplication" name="Validate application">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.validateApplication" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_leasingRequestReceivedToValidateApplication</bpmn:incoming>
      <bpmn:outgoing>flow_validateApplicationToCheckCreditRating</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="businessRuleTask_checkCreditRating" name="Check credit rating">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="checkCreditRating" resultVariable="solvent" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_validateApplicationToCheckCreditRating</bpmn:incoming>
      <bpmn:outgoing>flow_checkCreditRatingToIsSolvent</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gateway_isSolvent" name="Solvent?" default="flow_isSolventToConcludeContract">
      <bpmn:incoming>flow_checkCreditRatingToIsSolvent</bpmn:incoming>
      <bpmn:outgoing>flow_isSolventToConcludeContract</bpmn:outgoing>
      <bpmn:outgoing>flow_isSolventToCollectRejections</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="subProcess_concludeContract" name="Conclude contract">
      <bpmn:incoming>flow_isSolventToConcludeContract</bpmn:incoming>
      <bpmn:outgoing>flow_concludeContractToFork</bpmn:outgoing>
      <bpmn:startEvent id="startEvent_customerEligible" name="Customer eligible">
        <bpmn:outgoing>flow_customerEligibleToSendContract</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="serviceTask_sendContract" name="Send contract">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="miravelo.sendContract" />
          <zeebe:ioMapping>
            <zeebe:input source="=applicationId" target="applicationId" />
            <zeebe:output source="=contractId" target="contractId" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_customerEligibleToSendContract</bpmn:incoming>
        <bpmn:outgoing>flow_sendContractToAwaitSignature</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:eventBasedGateway id="gateway_awaitSignature" name="Await signature">
        <bpmn:incoming>flow_sendContractToAwaitSignature</bpmn:incoming>
        <bpmn:outgoing>flow_awaitSignatureToContractSigned</bpmn:outgoing>
        <bpmn:outgoing>flow_awaitSignatureToSignatureDeadline</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="event_contractSigned" name="Contract signed">
        <bpmn:incoming>flow_awaitSignatureToContractSigned</bpmn:incoming>
        <bpmn:outgoing>flow_contractSignedToContractConcluded</bpmn:outgoing>
        <bpmn:messageEventDefinition id="messageEventDefinition_contractSigned" messageRef="message_contractSigned" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="endEvent_contractConcluded" name="Contract concluded">
        <bpmn:incoming>flow_contractSignedToContractConcluded</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="timer_signatureDeadline" name="14 days passed">
        <bpmn:incoming>flow_awaitSignatureToSignatureDeadline</bpmn:incoming>
        <bpmn:outgoing>flow_signatureDeadlineToContractNotSigned</bpmn:outgoing>
        <bpmn:timerEventDefinition id="timerEventDefinition_signatureDeadline">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="endEvent_contractNotSigned" name="Contract not signed">
        <bpmn:incoming>flow_signatureDeadlineToContractNotSigned</bpmn:incoming>
        <bpmn:escalationEventDefinition id="escalationEventDefinition_contractNotSigned" escalationRef="escalation_contractNotSigned" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_customerEligibleToSendContract" sourceRef="startEvent_customerEligible" targetRef="serviceTask_sendContract" />
      <bpmn:sequenceFlow id="flow_sendContractToAwaitSignature" sourceRef="serviceTask_sendContract" targetRef="gateway_awaitSignature" />
      <bpmn:sequenceFlow id="flow_awaitSignatureToContractSigned" sourceRef="gateway_awaitSignature" targetRef="event_contractSigned" />
      <bpmn:sequenceFlow id="flow_contractSignedToContractConcluded" sourceRef="event_contractSigned" targetRef="endEvent_contractConcluded" />
      <bpmn:sequenceFlow id="flow_awaitSignatureToSignatureDeadline" sourceRef="gateway_awaitSignature" targetRef="timer_signatureDeadline" />
      <bpmn:sequenceFlow id="flow_signatureDeadlineToContractNotSigned" sourceRef="timer_signatureDeadline" targetRef="endEvent_contractNotSigned" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="boundary_compensateContract" name="Contract to revoke" attachedToRef="subProcess_concludeContract">
      <bpmn:compensateEventDefinition id="compensateEventDefinition_compensateContract" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_contractNotSigned" name="Contract not signed" attachedToRef="subProcess_concludeContract">
      <bpmn:outgoing>flow_contractNotSignedToCollectRejections</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="escalationEventDefinition_catchContractNotSigned" escalationRef="escalation_contractNotSigned" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="timer_signatureReminder" name="7 days passed" cancelActivity="false" attachedToRef="subProcess_concludeContract">
      <bpmn:outgoing>flow_signatureReminderToSendReminderMail</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timerEventDefinition_signatureReminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="serviceTask_sendReminderMail" name="Send reminder mail">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.sendReminderMail" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_signatureReminderToSendReminderMail</bpmn:incoming>
      <bpmn:outgoing>flow_sendReminderMailToCustomerReminded</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_customerReminded" name="Customer reminded">
      <bpmn:incoming>flow_sendReminderMailToCustomerReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="serviceTask_cancelContract" name="Cancel contract" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.cancelContract" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="boundary_applicationInvalid" name="Application invalid" attachedToRef="serviceTask_validateApplication">
      <bpmn:outgoing>flow_applicationInvalidToCollectRejections</bpmn:outgoing>
      <bpmn:errorEventDefinition id="errorEventDefinition_applicationInvalid" errorRef="error_applicationInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="gateway_collectRejections">
      <bpmn:incoming>flow_isSolventToCollectRejections</bpmn:incoming>
      <bpmn:incoming>flow_applicationInvalidToCollectRejections</bpmn:incoming>
      <bpmn:incoming>flow_contractNotSignedToCollectRejections</bpmn:incoming>
      <bpmn:outgoing>flow_collectRejectionsToSendRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="serviceTask_sendRejection" name="Send rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.sendRejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_collectRejectionsToSendRejection</bpmn:incoming>
      <bpmn:outgoing>flow_sendRejectionToApplicationRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_applicationRejected" name="Application rejected">
      <bpmn:incoming>flow_sendRejectionToApplicationRejected</bpmn:incoming>
      <bpmn:terminateEventDefinition id="terminateEventDefinition_applicationRejected" />
    </bpmn:endEvent>
    <bpmn:parallelGateway id="gateway_fork">
      <bpmn:incoming>flow_concludeContractToFork</bpmn:incoming>
      <bpmn:outgoing>flow_forkToOrderBike</bpmn:outgoing>
      <bpmn:outgoing>flow_forkToIssueInsurancePolicy</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="serviceTask_orderBike" name="Order bike" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="8">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://supplier.miravelo.example/orders" target="url" />
          <zeebe:input source="={bikeId: bikeId}" target="body" />
          <zeebe:output source="=response.body.orderId" target="orderId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_forkToOrderBike</bpmn:incoming>
      <bpmn:outgoing>flow_orderBikeToJoin</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=bikeIds" inputElement="bikeId" outputCollection="orderIds" outputElement="=orderId" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="serviceTask_issueInsurancePolicy" name="Issue insurance policy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.issueInsurancePolicy" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_forkToIssueInsurancePolicy</bpmn:incoming>
      <bpmn:outgoing>flow_issueInsurancePolicyToJoin</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=bikeIds" inputElement="bikeId" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="boundary_compensateOrder" name="Order to cancel" attachedToRef="serviceTask_orderBike">
      <bpmn:compensateEventDefinition id="compensateEventDefinition_compensateOrder" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundary_compensateInsurance" name="Policy to cancel" attachedToRef="serviceTask_issueInsurancePolicy">
      <bpmn:compensateEventDefinition id="compensateEventDefinition_compensateInsurance" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="callActivity_cancelBikeOrder" name="Cancel bike order" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="cancelBikeOrder" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=orderIds" target="orderIds" />
          <zeebe:output source="=cancellationCosts" target="cancellationCosts" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:serviceTask id="serviceTask_cancelPolicy" name="Cancel policy" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.cancelPolicy" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="gateway_join">
      <bpmn:incoming>flow_orderBikeToJoin</bpmn:incoming>
      <bpmn:incoming>flow_issueInsurancePolicyToJoin</bpmn:incoming>
      <bpmn:outgoing>flow_joinToHandoverReported</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:receiveTask id="receiveTask_handoverReported" name="Await bike handover" messageRef="message_handoverReported">
      <bpmn:incoming>flow_joinToHandoverReported</bpmn:incoming>
      <bpmn:outgoing>flow_handoverReportedToWithdrawalPeriodElapsed</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateCatchEvent id="timer_withdrawalPeriodElapsed" name="Withdrawal period elapsed">
      <bpmn:incoming>flow_handoverReportedToWithdrawalPeriodElapsed</bpmn:incoming>
      <bpmn:outgoing>flow_withdrawalPeriodElapsedToLeasingActive</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timerEventDefinition_withdrawalPeriodElapsed">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=withdrawalPeriod</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endEvent_leasingActive" name="Leasing active">
      <bpmn:incoming>flow_withdrawalPeriodElapsedToLeasingActive</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="subProcess_applicationWithdrawn" name="Application withdrawn" triggeredByEvent="true">
      <bpmn:startEvent id="startEvent_applicationWithdrawn" name="Application withdrawn">
        <bpmn:outgoing>flow_applicationWithdrawnToReverseApplication</bpmn:outgoing>
        <bpmn:messageEventDefinition id="messageEventDefinition_applicationWithdrawn" messageRef="message_applicationWithdrawn" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="event_reverseApplication" name="Application reversed">
        <bpmn:incoming>flow_applicationWithdrawnToReverseApplication</bpmn:incoming>
        <bpmn:outgoing>flow_reverseApplicationToSendCancellationConfirmation</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="compensateEventDefinition_reverseApplication" />
      </bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="serviceTask_sendCancellationConfirmation" name="Send cancellation confirmation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="miravelo.sendCancellationConfirmation" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow_reverseApplicationToSendCancellationConfirmation</bpmn:incoming>
        <bpmn:outgoing>flow_sendCancellationConfirmationToApplicationCancelled</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="endEvent_applicationCancelled" name="Application cancelled">
        <bpmn:incoming>flow_sendCancellationConfirmationToApplicationCancelled</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_applicationWithdrawnToReverseApplication" sourceRef="startEvent_applicationWithdrawn" targetRef="event_reverseApplication" />
      <bpmn:sequenceFlow id="flow_reverseApplicationToSendCancellationConfirmation" sourceRef="event_reverseApplication" targetRef="serviceTask_sendCancellationConfirmation" />
      <bpmn:sequenceFlow id="flow_sendCancellationConfirmationToApplicationCancelled" sourceRef="serviceTask_sendCancellationConfirmation" targetRef="endEvent_applicationCancelled" />
    </bpmn:subProcess>
    <bpmn:subProcess id="subProcess_addressChanged" name="Delivery address changed" triggeredByEvent="true">
      <bpmn:startEvent id="startEvent_addressChanged" name="Address changed" isInterrupting="false">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=street" target="street" />
            <zeebe:output source="=city" target="city" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>flow_addressChangedToUpdateDeliveryAddress</bpmn:outgoing>
        <bpmn:messageEventDefinition id="messageEventDefinition_addressChanged" messageRef="message_addressChanged" />
      </bpmn:startEvent>
      <bpmn:userTask id="userTask_updateDeliveryAddress" name="Update delivery address">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:ioMapping>
            <zeebe:input source="=deliveryAddress" target="deliveryAddress" />
            <zeebe:output source="=deliveryAddress" target="deliveryAddress" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_addressChangedToUpdateDeliveryAddress</bpmn:incoming>
        <bpmn:outgoing>flow_updateDeliveryAddressToDeliveryAddressUpdated</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="endEvent_deliveryAddressUpdated" name="Delivery address updated">
        <bpmn:incoming>flow_updateDeliveryAddressToDeliveryAddressUpdated</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_addressChangedToUpdateDeliveryAddress" sourceRef="startEvent_addressChanged" targetRef="userTask_updateDeliveryAddress" />
      <bpmn:sequenceFlow id="flow_updateDeliveryAddressToDeliveryAddressUpdated" sourceRef="userTask_updateDeliveryAddress" targetRef="endEvent_deliveryAddressUpdated" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_leasingRequestReceivedToValidateApplication" sourceRef="startEvent_leasingRequestReceived" targetRef="serviceTask_validateApplication" />
    <bpmn:sequenceFlow id="flow_validateApplicationToCheckCreditRating" sourceRef="serviceTask_validateApplication" targetRef="businessRuleTask_checkCreditRating" />
    <bpmn:sequenceFlow id="flow_checkCreditRatingToIsSolvent" sourceRef="businessRuleTask_checkCreditRating" targetRef="gateway_isSolvent" />
    <bpmn:sequenceFlow id="flow_isSolventToConcludeContract" name="Yes" sourceRef="gateway_isSolvent" targetRef="subProcess_concludeContract" />
    <bpmn:sequenceFlow id="flow_isSolventToCollectRejections" name="No" sourceRef="gateway_isSolvent" targetRef="gateway_collectRejections">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(solvent)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_applicationInvalidToCollectRejections" sourceRef="boundary_applicationInvalid" targetRef="gateway_collectRejections" />
    <bpmn:sequenceFlow id="flow_contractNotSignedToCollectRejections" sourceRef="boundary_contractNotSigned" targetRef="gateway_collectRejections" />
    <bpmn:sequenceFlow id="flow_collectRejectionsToSendRejection" sourceRef="gateway_collectRejections" targetRef="serviceTask_sendRejection" />
    <bpmn:sequenceFlow id="flow_sendRejectionToApplicationRejected" sourceRef="serviceTask_sendRejection" targetRef="endEvent_applicationRejected" />
    <bpmn:sequenceFlow id="flow_signatureReminderToSendReminderMail" sourceRef="timer_signatureReminder" targetRef="serviceTask_sendReminderMail" />
    <bpmn:sequenceFlow id="flow_sendReminderMailToCustomerReminded" sourceRef="serviceTask_sendReminderMail" targetRef="endEvent_customerReminded" />
    <bpmn:sequenceFlow id="flow_concludeContractToFork" sourceRef="subProcess_concludeContract" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="flow_forkToOrderBike" sourceRef="gateway_fork" targetRef="serviceTask_orderBike" />
    <bpmn:sequenceFlow id="flow_forkToIssueInsurancePolicy" sourceRef="gateway_fork" targetRef="serviceTask_issueInsurancePolicy" />
    <bpmn:sequenceFlow id="flow_orderBikeToJoin" sourceRef="serviceTask_orderBike" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_issueInsurancePolicyToJoin" sourceRef="serviceTask_issueInsurancePolicy" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_joinToHandoverReported" sourceRef="gateway_join" targetRef="receiveTask_handoverReported" />
    <bpmn:sequenceFlow id="flow_handoverReportedToWithdrawalPeriodElapsed" sourceRef="receiveTask_handoverReported" targetRef="timer_withdrawalPeriodElapsed" />
    <bpmn:sequenceFlow id="flow_withdrawalPeriodElapsedToLeasingActive" sourceRef="timer_withdrawalPeriodElapsed" targetRef="endEvent_leasingActive" />
    <bpmn:association id="association_compensateContract" associationDirection="One" sourceRef="boundary_compensateContract" targetRef="serviceTask_cancelContract" />
    <bpmn:association id="association_compensateOrder" associationDirection="One" sourceRef="boundary_compensateOrder" targetRef="callActivity_cancelBikeOrder" />
    <bpmn:association id="association_compensateInsurance" associationDirection="One" sourceRef="boundary_compensateInsurance" targetRef="serviceTask_cancelPolicy" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_bikeLeasing">
    <bpmndi:BPMNPlane id="plane_bikeLeasing" bpmnElement="bikeLeasing">
      <bpmndi:BPMNShape id="subProcess_concludeContract_di" bpmnElement="subProcess_concludeContract" isExpanded="true">
        <dc:Bounds x="670" y="130" width="520" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subProcess_applicationWithdrawn_di" bpmnElement="subProcess_applicationWithdrawn" isExpanded="true">
        <dc:Bounds x="240" y="660" width="520" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subProcess_addressChanged_di" bpmnElement="subProcess_addressChanged" isExpanded="true">
        <dc:Bounds x="820" y="660" width="440" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="startEvent_leasingRequestReceived_di" bpmnElement="startEvent_leasingRequestReceived">
        <dc:Bounds x="152" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="120" y="275" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="serviceTask_validateApplication_di" bpmnElement="serviceTask_validateApplication">
        <dc:Bounds x="250" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="businessRuleTask_checkCreditRating_di" bpmnElement="businessRuleTask_checkCreditRating">
        <dc:Bounds x="400" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_isSolvent_di" bpmnElement="gateway_isSolvent">
        <dc:Bounds x="555" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="530" y="193" width="100" height="27" />
