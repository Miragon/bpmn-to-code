<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_0vze3ke" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0">
  <bpmn:message id="message_formSubmitted" name="Message_FormSubmitted" />
  <bpmn:message id="message_subscriptionConfirmed" name="Message_SubscriptionConfirmed" />
  <bpmn:signal id="signal_registrationNotPossible" name="Signal_RegistrationNotPossible" />
  <bpmn:error id="error_invalidMail" name="Error_InvalidMail" errorCode="500" />
  <bpmn:process id="newsletterSubscription" isExecutable="true">
    <bpmn:extensionElements>
      <camunda:properties>
        <camunda:property name="variantName" value="withApproval" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:startEvent id="startEvent_submitRegistrationForm" name="Submit newsletter form">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="subscriptionId">${subscriptionId}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_submitToIncrementCounter</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="message_formSubmitted" />
    </bpmn:startEvent>
    <bpmn:subProcess id="subProcess_confirmation" name="Subscription Confirmation">
      <bpmn:incoming>flow_incrementCounterToConfirmation</bpmn:incoming>
      <bpmn:outgoing>flow_confirmationToSplit</bpmn:outgoing>
      <bpmn:startEvent id="startEvent_requestReceived" name="Subscription requested" camunda:asyncBefore="true">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="subscriptionId">${subscriptionId}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:outgoing>flow_requestToConfirmationMail</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="serviceTask_sendConfirmationMail" name="Send confirmation mail" camunda:type="external" camunda:topic="#{newsletterSendConfirmationMail}">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="subscriptionId">${subscriptionId}</camunda:inputParameter>
            <camunda:inputParameter name="otherVariable">dummy</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_requestToConfirmationMail</bpmn:incoming>
        <bpmn:incoming>flow_everyDayToConfirmationMail</bpmn:incoming>
        <bpmn:outgoing>flow_confirmationMailToConfirm</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="timer_everyDay" name="Every day" cancelActivity="false" attachedToRef="userTask_confirmRegistration">
        <bpmn:outgoing>flow_everyDayToConfirmationMail</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>PT1M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="flow_requestToConfirmationMail" sourceRef="startEvent_requestReceived" targetRef="serviceTask_sendConfirmationMail" />
      <bpmn:sequenceFlow id="flow_confirmationMailToConfirm" sourceRef="serviceTask_sendConfirmationMail" targetRef="userTask_confirmRegistration" />
      <bpmn:sequenceFlow id="flow_everyDayToConfirmationMail" sourceRef="timer_everyDay" targetRef="serviceTask_sendConfirmationMail" />
      <bpmn:endEvent id="endEvent_subscriptionConfirmed" name="Subscription confirmed">
        <bpmn:incoming>flow_confirmToConfirmed</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_confirmToConfirmed" sourceRef="userTask_confirmRegistration" targetRef="endEvent_subscriptionConfirmed" />
      <bpmn:userTask id="userTask_confirmRegistration" name="Confirm subscription" camunda:asyncAfter="true">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="subscriptionId">${subscriptionId}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>flow_confirmationMailToConfirm</bpmn:incoming>
        <bpmn:outgoing>flow_confirmToConfirmed</bpmn:outgoing>
      </bpmn:userTask>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_submitToIncrementCounter" sourceRef="startEvent_submitRegistrationForm" targetRef="serviceTask_incrementSubscriptionCounter" />
    <bpmn:boundaryEvent id="timer_after3Days" name="After 3 days" attachedToRef="subProcess_confirmation">
      <bpmn:outgoing>flow_after3DaysToAbort</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>${testVariable}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_after3DaysToAbort" sourceRef="timer_after3Days" targetRef="callActivity_abortRegistration" />
    <bpmn:sequenceFlow id="flow_abortToRegistrationAborted" sourceRef="callActivity_abortRegistration" targetRef="compensationEndEvent_registrationAborted" />
    <bpmn:serviceTask id="serviceTask_sendWelcomeMail" name="Send Welcome-Mail" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:exclusive="false" camunda:delegateExpression="${newsletterSendWelcomeMail}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="subscriptionId">${subscriptionId}</camunda:inputParameter>
          <camunda:outputParameter name="subscriptionId">${subscriptionId}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_splitToWelcomeMail</bpmn:incoming>
      <bpmn:outgoing>flow_welcomeMailToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_confirmationToSplit" sourceRef="subProcess_confirmation" targetRef="gateway_splitNotifications" />
    <bpmn:parallelGateway id="gateway_splitNotifications">
      <bpmn:incoming>flow_confirmationToSplit</bpmn:incoming>
      <bpmn:outgoing>flow_splitToWelcomeMail</bpmn:outgoing>
      <bpmn:outgoing>flow_splitToNotifyCommunity</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_splitToWelcomeMail" sourceRef="gateway_splitNotifications" targetRef="serviceTask_sendWelcomeMail" />
    <bpmn:serviceTask id="serviceTask_notifyCommunity" name="Notify community" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:exclusive="false" camunda:delegateExpression="${newsletterNotifyCommunity}">
      <bpmn:incoming>flow_splitToNotifyCommunity</bpmn:incoming>
      <bpmn:outgoing>flow_notifyCommunityToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_splitToNotifyCommunity" sourceRef="gateway_splitNotifications" targetRef="serviceTask_notifyCommunity" />
    <bpmn:parallelGateway id="gateway_joinNotifications">
      <bpmn:incoming>flow_welcomeMailToJoin</bpmn:incoming>
      <bpmn:incoming>flow_notifyCommunityToJoin</bpmn:incoming>
      <bpmn:outgoing>flow_joinToRegistrationCompleted</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_notifyCommunityToJoin" sourceRef="serviceTask_notifyCommunity" targetRef="gateway_joinNotifications" />
    <bpmn:endEvent id="endEvent_registrationCompleted" name="Registration completed">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="subscriptionId">${subscriptionId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_joinToRegistrationCompleted</bpmn:incoming>
      <bpmn:messageEventDefinition camunda:type="external" camunda:topic="newsletter.registrationCompleted" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_welcomeMailToJoin" sourceRef="serviceTask_sendWelcomeMail" targetRef="gateway_joinNotifications" />
    <bpmn:sequenceFlow id="flow_joinToRegistrationCompleted" sourceRef="gateway_joinNotifications" targetRef="endEvent_registrationCompleted" />
    <bpmn:boundaryEvent id="errorEvent_invalidMail" name="Invalid Mail" attachedToRef="subProcess_confirmation">
      <bpmn:outgoing>flow_invalidMailToNotPossible</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="error_invalidMail" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_invalidMailToNotPossible" sourceRef="errorEvent_invalidMail" targetRef="endEvent_registrationNotPossible" />
    <bpmn:endEvent id="endEvent_registrationNotPossible" name="Registration not possible" camunda:asyncBefore="true" camunda:exclusive="false">
      <bpmn:incoming>flow_invalidMailToNotPossible</bpmn:incoming>
      <bpmn:signalEventDefinition signalRef="signal_registrationNotPossible" />
    </bpmn:endEvent>
    <bpmn:callActivity id="callActivity_abortRegistration" name="Abort registration" camunda:asyncBefore="true" camunda:asyncAfter="true" calledElement="abort-registration">
      <bpmn:extensionElements>
        <camunda:in source="subscriptionId" target="childSubscriptionId" />
        <camunda:in sourceExpression="${reasonCode}" target="childReasonCode" />
        <camunda:out source="childAbortResult" target="abortResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_after3DaysToAbort</bpmn:incoming>
      <bpmn:outgoing>flow_abortToRegistrationAborted</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="flow_incrementCounterToConfirmation" sourceRef="serviceTask_incrementSubscriptionCounter" targetRef="subProcess_confirmation" />
    <bpmn:serviceTask id="serviceTask_incrementSubscriptionCounter" name="Increment subscription counter" camunda:delegateExpression="counterClass">
      <bpmn:incoming>flow_submitToIncrementCounter</bpmn:incoming>
      <bpmn:outgoing>flow_incrementCounterToConfirmation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="compensationEndEvent_registrationAborted" name="Registration aborted">
      <bpmn:incoming>flow_abortToRegistrationAborted</bpmn:incoming>
      <bpmn:compensateEventDefinition id="compensateEventDefinition_incrementSubscriptionCounter" activityRef="serviceTask_incrementSubscriptionCounter" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="compensationEvent_onSubscriptionCounter" name="Registration aborted" camunda:asyncAfter="true" attachedToRef="serviceTask_incrementSubscriptionCounter">
      <bpmn:compensateEventDefinition id="compensateEventDefinition_onSubscriptionCounter" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="serviceTask_decrementSubscriptionCounter" name="Decrement subscription counter" isForCompensation="true" camunda:delegateExpression="counterClass">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="subscriptionId">${subscriptionId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:association id="association_compensateSubscriptionCounter" associationDirection="One" sourceRef="compensationEvent_onSubscriptionCounter" targetRef="serviceTask_decrementSubscriptionCounter" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="newsletterSubscription">
      <bpmndi:BPMNShape id="Event_12xytcj_di" bpmnElement="startEvent_submitRegistrationForm">
