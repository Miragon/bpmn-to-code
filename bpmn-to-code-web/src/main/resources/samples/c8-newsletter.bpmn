          <dc:Bounds x="602" y="379" width="29" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_requestToConfirmationMail_di" bpmnElement="flow_requestToConfirmationMail">
        <di:waypoint x="368" y="320" />
        <di:waypoint x="410" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirmationMailToConfirm_di" bpmnElement="flow_confirmationMailToConfirm">
        <di:waypoint x="510" y="320" />
        <di:waypoint x="550" y="320" />
      </bpmndi:BPMNEdge>
