        <dc:Bounds x="820" y="280" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_12xytcj_di" bpmnElement="startEvent_submitRegistrationForm">
        <dc:Bounds x="182" y="302" width="36" height="36" />
